# Hazlo environment template
# Copy to .env.local for local frontend work, or configure these in Vercel.

# Server-side Vercel environment variables
NOTION_TOKEN=your_notion_token_here
NOTION_DATA_SOURCE_ID=your_notion_data_source_id_here
API_SECRET=generate_a_random_value

# Frontend environment variables
VITE_API_SECRET=use_the_same_value_as_API_SECRET

# Optional: leave empty when the frontend and /api routes share the same origin.
VITE_API_BASE_URL=
