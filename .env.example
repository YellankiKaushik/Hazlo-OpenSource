# Hazlo environment template.
# Copy this file to .env.local for local work.
# In production, configure the same keys in Vercel Project Settings.

# Server-side variables. Never expose real values in frontend code.
NOTION_TOKEN=your_notion_token_here
NOTION_DATA_SOURCE_ID=your_notion_data_source_id_here
# Remote writes are disabled by default. See SECURITY.md before opting in.
NOTION_SYNC_ENABLED=false
NOTION_ALLOWED_ORIGINS=

# Browser-visible build flag, not a credential. False makes capture local-only.
VITE_NOTION_SYNC_ENABLED=false

# To enable personal sync, set both flags to true and NOTION_ALLOWED_ORIGINS
# to your exact app origin (https://your-app.vercel.app; no trailing slash).
# Vercel Preview deployments always disable writes. Do not give them Notion tokens.
# API_SECRET, VITE_API_SECRET and VITE_API_BASE_URL are retired; remove old values.
